generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id                     Int             @id @default(autoincrement())
  nombre                 String
  plataforma             String          @default("default")
  producto               String          @default("facturacion")
  descripcion            String?
  limiteUsuarios         Int?
  maxSedes               Int?            @default(1)
  costo                  Decimal         @default(0)
  esPrueba               Boolean         @default(false)
  duracionDias           Int             @default(30)
  tipoFacturacion        String          @default("MENSUAL")
  tieneTienda            Boolean         @default(false)
  maxBanners             Int?            @default(3)
  maxImagenesProducto    Int?            @default(1)
  tieneBanners           Boolean         @default(false)
  tieneCulqi             Boolean         @default(false)
  tieneDeliveryGPS       Boolean         @default(false)
  tieneGaleria           Boolean         @default(false)
  maxComprobantes        Int?            @default(100)
  tieneTicketera         Boolean         @default(false)
  tieneGestionLotes      Boolean         @default(false)
  tieneGestionProvisiones Boolean         @default(false)
  tieneDescripcionRica   Boolean         @default(false)
  empresas               Empresa[]
  features               PlanFeature[]
  modulosAsignados       PlanModulo[]
  subModulosAsignados    PlanSubModulo[]

  @@unique([nombre, plataforma, producto])
  @@index([plataforma])
  @@index([producto])
  @@index([plataforma, producto])
}

model PlanFeature {
  id        Int      @id @default(autoincrement())
  planId    Int
  featureKey String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}

model Ubigeo {
  codigo       String    @id
  departamento String
  provincia    String
  distrito     String
  empresas     Empresa[]
}

model Rubro {
  id         Int                 @id @default(autoincrement())
  nombre     String              @unique
  disenos    DisenoRubro?
  empresas   Empresa[]
  plantillas ProductoPlantilla[]
  features   RubroFeature[]
  fichasTecnicas FichaTecnicaPlantilla[]
}

model RubroFeature {
  id               Int      @id @default(autoincrement())
  rubroId          Int
  featureKey       String
  enabledByDefault Boolean  @default(false)
  config           Json?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  rubro Rubro @relation(fields: [rubroId], references: [id], onDelete: Cascade)

  @@unique([rubroId, featureKey])
  @@index([featureKey])
}

model Empresa {
  id                      Int                           @id @default(autoincrement())
  ruc                     String                        @unique
  razonSocial             String
  direccion               String
  logo                    String?
  fechaActivacion         DateTime
  fechaExpiracion         DateTime
  cicloFacturacion        String                        @default("MENSUAL") // MENSUAL | ANUAL — ciclo de cobro reseller→plataforma
  planId                  Int
  estado                  EstadoType                    @default(ACTIVO)
  departamento            String?
  distrito                String?
  provincia               String?
  ubigeo                  String?
  providerToken           String?
  billingProvider         BillingProvider               @default(QPSE)
  billingApiBaseUrl       String?
  billingApiDemoBaseUrl   String?
  billingApiToken         String?
  billingApiUser          String?
  billingApiPassword      String?
  tokenCreatedAt          DateTime?
  tokenUpdatedAt          DateTime?
  empresaUbigeo           String?
  nombreComercial         String?
  paginaWeb               String?
  cuentaDetraccionBN      String?
  cotizMostrarEmail       Boolean                       @default(true)
  cotizMostrarCuentas     Boolean                       @default(true)
  cotizMostrarRazonSocial Boolean                       @default(true)
  cotizMostrarDetraccion  Boolean                       @default(true)
  cotizFormatoConfig      Json?
  notaVentaFormatoConfig  Json?
  facturaFormatoConfig    Json?
  boletaFormatoConfig     Json?
  // Textos por defecto que el negocio decide recordar para próximas cotizaciones
  // (Términos y Condiciones / Observaciones). Se autocompletan al crear una cotización.
  cotizTerminosDefault    String?
  cotizObservacionesDefault String?
  rubroId                 Int?
  providerId              String?
  tipoEmpresa             TipoEmpresa                   @default(FORMAL)
  // Régimen tributario SUNAT: GENERAL | RER | MYPE | RUS. Por defecto GENERAL para no
  // alterar empresas existentes. En RUS se bloquea la emisión de Factura (solo boletas).
  regimenTributario       String                        @default("GENERAL")
  aceptaEfectivo          Boolean                       @default(true)
  colorPrimario           String?                       @default("#000000")
  colorSecundario         String?                       @default("#ffffff")
  descripcionTienda       String?
  facebookUrl             String?
  horarioAtencion         String?
  instagramUrl            String?
  plinNumero              String?
  plinQrUrl               String?
  slugTienda              String?                       @unique
  tiktokUrl               String?
  whatsappTienda          String?
  whatsappProvider        WhatsAppProvider              @default(PLATFORM)
  whatsappApiToken        String?
  whatsappPhoneNumberId   String?
  whatsappBusinessId      String?
  whatsappActivo          Boolean                       @default(true)
  shalomEmail             String?
  shalomPassword          String?
  yapeNumero              String?
  yapeQrUrl               String?
  aceptaEnvio             Boolean                       @default(true)
  aceptaRecojo            Boolean                       @default(true)
  esAgenteRetencion       Boolean                       @default(false)
  ticketLogoSize          Int?                          @default(96)
  usaCodigoBarrasManual   Boolean?
  usarPrecioLoteFefo      Boolean                       @default(false)
  // Sobreventa: cuando es true, la venta/comprobante NO se bloquea por falta de stock
  // (se registra la salida aunque el stock quede en 0/negativo). Default false = mantiene
  // el bloqueo por stock insuficiente.
  permitirVentaSinStock   Boolean                       @default(false)
  // Cobranza con vendedores de campo: cuando es true, "Registrar Pago" pide el vendedor de
  // campo que envió el comprobante, a quién se dirigió el pago y permite adjuntar el comprobante.
  // Default false = flujo de cobro estándar (la mayoría de negocios).
  cobranzaCampo           Boolean                       @default(false)
  // Aprobación (maker-checker): los GASTOS/egresos de caja registrados por
  // USUARIO_EMPRESA quedan PENDIENTES y no afectan el cierre hasta que un
  // ADMIN_EMPRESA los apruebe. Default false = efecto inmediato (la mayoría).
  requiereAprobacionGastos  Boolean                     @default(false)
  // Aprobación de COMPRAS de vendedores: quedan PENDIENTE_APROBACION sin
  // ingresar stock ni aceptar pagos hasta que un ADMIN_EMPRESA las apruebe.
  requiereAprobacionCompras Boolean                     @default(false)
  // Caja obligatoria: nadie (incluido el admin) puede emitir comprobantes
  // (facturas/boletas/notas de venta/tickets) sin tener SU caja abierta en la
  // sede. Las cotizaciones están exentas (no mueven stock ni caja).
  requiereCajaParaEmitir    Boolean                     @default(false)
  costoActivacionReseller Decimal?                      @default(0)
  precioClienteFinal      Decimal?                      @db.Decimal(10, 2) // Precio mensual que el reseller le cobra a este cliente (para calcular ganancia). Null = usar precio de lista del plan.
  esWhiteLabel            Boolean                       @default(false) // Cliente bajo la marca blanca del reseller vs. marca estándar.
  costoEnvioFijo          Decimal?                      @default(0)
  envioGratisDesdeSoles   Decimal?                      @default(0)
  minimoCompra            Decimal?                      @default(0)
  direccionRecojo         String?
  tiempoPreparacionMin    Int?                          @default(30)
  disenoOverride          String?
  directorTecnico         String?
  banners                 Banner[]
  categorias              Categoria[]
  clientes                Cliente[]
  compras                 Compra[]
  ordenesCompra           OrdenCompra[]
  comprobantes            Comprobante[]
  ubicacion               Ubigeo?                       @relation(fields: [empresaUbigeo], references: [codigo])
  plan                    Plan                          @relation(fields: [planId], references: [id])
  rubro                   Rubro?                        @relation(fields: [rubroId], references: [id])
  marcas                  Marca[]
  movimientosCaja         MovimientoCaja[]
  movimientosKardex       MovimientoKardex[]
  Notificacion            Notificacion[]
  pagos                   Pago[]
  pagosCompra             PagoCompra[]
  pedidosTienda           PedidoTienda[]
  preferenciasTabla       PreferenciaTabla[]
  productos               Producto[]
  usuarios                Usuario[]
  whatsappEnvios          WhatsAppEnvio[]
  combos                  Combo[]
  gruposModificadores     GrupoModificador[]
  guiasRemision           GuiaRemision[]
  sedes                   Sede[]
  recetasProduccion       RecetaProduccion[]
  ordenesProduccion       OrdenProduccion[]
  movimientosProduccion   MovimientoProduccion[]
  vinculosXmlProductos    VinculoProductoProveedorXml[]
  imagenesProductoIa      ImagenProductoAprobadaIa[]
  reservas                Reserva[]

  repartidores            Repartidor[]
  despachoMensajeTemplate DespachoMensajeTemplate?

  bancoNombre         String?
  numeroCuenta        String?
  cci                 String?
  monedaCuenta        String?              @default("SOLES")
  resellerId          Int?
  reseller            Reseller?            @relation(fields: [resellerId], references: [id])
  resellerMovimientos ResellerMovimiento[]
  brand               String               @default("default")
  producto            String               @default("facturacion")
  hotelTenantId       String?
  hotelAdminUserId    String?
  hotelSyncAt         DateTime?
  restauranteTenantId    String?
  restauranteAdminUserId String?
  restauranteSyncAt      DateTime?
  usuarioPse          String?
  contrasenaPse       String?
  // Credenciales de API "Consulta de Validez de CPE" de SUNAT (portal SOL).
  sunatClientId       String?
  sunatClientSecret   String?
  qpseExternalId      String?
  usaDemo             Boolean              @default(false)
  // false = el cron de renovaciones NO cobra ni reactiva este cliente.
  // Se apaga al suspenderlo manualmente el reseller; se enciende al reactivarlo.
  renovacionAutomatica Boolean             @default(true)
  metodoSalidaLotes   String               @default("LIFO")
  notas               NotaEmpresa[]
  logs                EmpresaLog[]
  gastosOperativos    GastoOperativo[]
  conciliacionesGuardadas ConciliacionBancariaGuardada[]
  ingresosManual      IngresoManual[]
  comisionesVendedor  ComisionVendedor[]
  campanas            CampanaMarketing[]
  series              EmpresaSerie[]
  productoSeries      ProductoSerie[]
  reclamosGarantia    ReclamoGarantia[]
  productoReviews     ProductoReview[]
  fichasTecnicas      FichaTecnicaPlantilla[]
  cuentasBancarias    CuentaBancaria[]
  doctors             Doctor[]
  vehiculos           Vehiculo[]
  contratosVehiculares ContratoVehicular[]
  listasPrecio        ListaPrecio[]

  @@index([providerToken])
  @@index([slugTienda])
  @@index([brand])
  @@index([producto])
  @@index([brand, producto])
  @@index([whatsappProvider])
}

model EmpresaSerie {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  tipoDoc       String
  serie         String
  correlativo   Int      @default(1)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipoDoc, serie])
  @@index([empresaId, tipoDoc, activo])
}

model Usuario {
  id                     Int                     @id @default(autoincrement())
  nombre                 String
  dni                    String
  celular                String
  email                  String                  @unique
  password               String
  rol                    Rol
  empresaId              Int?
  estado                 EstadoType              @default(ACTIVO)
  telefono               String?
  permisos               String?
  compras                Compra[]
  ordenesCompra          OrdenCompra[]
  comprobantes           Comprobante[]
  historialEstadosPedido HistorialEstadoPedido[]
  movimientosCaja        MovimientoCaja[]
  depositosCajaRealizados MovimientoCaja[]              @relation("DepositoCajaRealizadoPor")
  movimientosKardex      MovimientoKardex[]
  Notificacion           Notificacion[]
  pagos                  Pago[]
  pagosCompra            PagoCompra[]
  preferenciasTabla      PreferenciaTabla[]
  refreshTokens          RefreshToken[]
  empresa                Empresa?                @relation(fields: [empresaId], references: [id])
  whatsappEnvios         WhatsAppEnvio[]
  guiasRemision          GuiaRemision[]
  sedeId                 Int?
  sede                   Sede?                   @relation(fields: [sedeId], references: [id])
  resellerId             Int?
  reseller               Reseller?               @relation(fields: [resellerId], references: [id])
  sistemaNegocio         String?
  sistemaProducto        String?
  sedesAsignadas         UsuarioSede[]
  subModulosAsignados    UsuarioSubModulo[]
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  ordenesProduccion      OrdenProduccion[]
  movimientosProduccion  MovimientoProduccion[]
  comisiones             ComisionVendedor[]
  campanas               CampanaMarketing[]
  comisionGlobal         Decimal?                @db.Decimal(12, 2)
  comisionGlobalFija     Decimal?                @db.Decimal(12, 2)
  comisionGlobalVenta    Decimal?                @db.Decimal(12, 2)
  actasInspeccion        ActaInspeccion[]
  listasPrecio           ListaPrecioUsuario[]

}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  imagenUrl String?
  empresaId Int?
  empresa   Empresa?   @relation(fields: [empresaId], references: [id])
  productos Producto[]
  fichasTecnicas FichaTecnicaPlantilla[]
}

model FichaTecnicaPlantilla {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  rubroId        Int?
  categoriaId    Int?
  empresaId      Int?
  campos         Json
  destacados     Json?
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  rubro     Rubro?     @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  empresa   Empresa?   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([rubroId])
  @@index([categoriaId])
  @@index([empresaId])
  @@index([activo])
}

model UnidadMedida {
  id        Int        @id @default(autoincrement())
  codigo    String     @unique
  nombre    String
  productos Producto[]
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String
  imagenUrl String?
  empresaId Int?
  empresa   Empresa?   @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
}

model Producto {
  id                       Int                           @id @default(autoincrement())
  codigo                   String
  descripcion              String
  categoriaId              Int?
  unidadMedidaId           Int
  tipoAfectacionIGV        String
  precioUnitario           Decimal
  valorUnitario            Decimal
  igvPorcentaje            Decimal                       @default(18.00)
  moneda                   String                        @default("PEN") // "PEN" (soles) o "USD" (dólares). Al facturar, USD se convierte a PEN con el TC del día.
  stock                    Decimal                       @default(0) @db.Decimal(12, 3)
  estado                   EstadoType                    @default(ACTIVO)
  creadoEn                 DateTime                      @default(now())
  empresaId                Int?
  costoPromedio            Decimal?                      @default(0)
  costoFijo                Decimal?                      @default(0)
  comisionPorVenta         Decimal?
  comisionPorcentaje       Decimal?
  stockMaximo              Int?
  stockMinimo              Int?                          @default(0)
  descripcionLarga         String?
  destacado                Boolean                       @default(false)
  imagenUrl                String?
  imagenesExtra            String?
  publicarEnTienda         Boolean                       @default(true)
  marcaId                  Int?
  ratingAvg                Decimal?                      @default(0)
  ratingCount              Int?                          @default(0)
  codigoBarras             String?
  codigoDigemid            String?
  codProdSunat             String?
  concentracion            String?
  controlado               Boolean                       @default(false)
  factorConversion         Int                           @default(1)
  fechaFinOferta           DateTime?
  fechaInicioOferta        DateTime?
  laboratorio              String?
  ofertaActiva             Boolean                       @default(false)
  pesoGramos               Decimal?
  precioOferta             Decimal?
  presentacion             String?
  principioActivo          String?
  refrigerado              Boolean                       @default(false)
  requiereReceta           Boolean                       @default(false)
  unidadCompra             String?
  unidadVenta              String?
  volumenMl                Decimal?
  preciosMayorista         Json?
  atributosTecnicos        Json?
  localizacion             String?
  porcentajeVenta          Int                           @default(100)
  porcentajeProvision      Int                           @default(0)
  detalleCompras           DetalleCompra[]
  detallesOrdenCompra      DetalleOrdenCompra[]
  detalleComprobantes      DetalleComprobante[]
  galeria                  GaleriaProducto[]
  itemsPedido              ItemPedidoTienda[]
  movimientosKardex        MovimientoKardex[]
  productoPadreId          Int?
  opcionesAtributos        Json?
  valoresAtributos         Json?

  categoria                Categoria?                    @relation(fields: [categoriaId], references: [id])
  productoPadre            Producto?                     @relation("ProductoVariantes", fields: [productoPadreId], references: [id])
  variantes                Producto[]                    @relation("ProductoVariantes")
  empresa                  Empresa?                      @relation(fields: [empresaId], references: [id])
  marca                    Marca?                        @relation(fields: [marcaId], references: [id])
  unidadMedida             UnidadMedida                  @relation(fields: [unidadMedidaId], references: [id])
  comboItems               ComboItem[]
  gruposModificadores      ProductoGrupoModificador[]
  lotes                    ProductoLote[]
  codigosBarras            ProductoCodigoBarras[]
  detallesGuiaRemision     DetalleGuiaRemision[]
  stocks                   ProductoStock[]
  recetasComoProductoFinal RecetaProduccion[]            @relation("RecetaProductoFinal")
  recetasComoInsumo        RecetaComponente[]            @relation("RecetaProductoInsumo")
  ordenesComoProductoFinal OrdenProduccion[]             @relation("OrdenProductoFinal")
  componentesProduccion    OrdenProduccionComponente[]   @relation("OrdenProductoInsumo")
  movimientosProduccion    MovimientoProduccion[]
  vinculosProveedorXml     VinculoProductoProveedorXml[]
  reservas                 Reserva[]
  campanas                 CampanaMarketing[]
  seriesInventario         ProductoSerie[]
  reviews                  ProductoReview[]
  contratosVehiculares     ContratoVehicular[]
  listaPrecioItems         ListaPrecioItem[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, codigoDigemid])
  @@index([empresaId, publicarEnTienda])
  @@index([marcaId])
  @@index([empresaId, codigoBarras])
}

enum EstadoProductoReview {
  PENDIENTE
  APROBADO
  RECHAZADO
  OCULTO
}

model ProductoReview {
  id              Int                  @id @default(autoincrement())
  empresaId       Int
  productoId      Int
  pedidoId        Int?
  clienteId       Int?
  clienteNombre   String
  clienteEmail    String?
  clienteTelefono String?
  rating          Int
  comentario      String
  estado          EstadoProductoReview @default(PENDIENTE)
  compraVerificada Boolean             @default(false)
  token           String?              @unique
  creadoEn        DateTime             @default(now())
  actualizadoEn   DateTime             @updatedAt
  aprobadoEn      DateTime?

  empresa  Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  pedido   PedidoTienda? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  cliente  Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([empresaId, estado, creadoEn])
  @@index([productoId, estado])
  @@index([pedidoId])
}

model RecetaProduccion {
  id                      Int                @id @default(autoincrement())
  empresaId               Int
  productoFinalId         Int
  codigo                  String
  nombre                  String
  version                 Int                @default(1)
  rendimientoObjetivo     Decimal
  unidadRendimiento       String
  mermaObjetivoPorcentaje Decimal?           @default(0)
  activo                  Boolean            @default(true)
  observaciones           String?
  creadoEn                DateTime           @default(now())
  actualizadoEn           DateTime           @updatedAt
  empresa                 Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoFinal           Producto           @relation("RecetaProductoFinal", fields: [productoFinalId], references: [id], onDelete: Cascade)
  componentes             RecetaComponente[]
  ordenes                 OrdenProduccion[]

  @@unique([empresaId, codigo, version])
  @@index([empresaId, activo])
  @@index([productoFinalId])
}

model RecetaComponente {
  id                      Int              @id @default(autoincrement())
  recetaId                Int
  productoInsumoId        Int
  orden                   Int              @default(0)
  cantidadBase            Decimal
  unidadBase              String
  mermaEsperadaPorcentaje Decimal?         @default(0)
  esOpcional              Boolean          @default(false)
  creadoEn                DateTime         @default(now())
  actualizadoEn           DateTime         @updatedAt
  receta                  RecetaProduccion @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  productoInsumo          Producto         @relation("RecetaProductoInsumo", fields: [productoInsumoId], references: [id], onDelete: Cascade)

  @@unique([recetaId, productoInsumoId, orden])
  @@index([recetaId])
  @@index([productoInsumoId])
}

model OrdenProduccion {
  id                   Int                         @id @default(autoincrement())
  empresaId            Int
  recetaId             Int?
  productoFinalId      Int
  loteProduccion       String
  fechaProgramada      DateTime?
  fechaInicio          DateTime?
  fechaFin             DateTime?
  cantidadObjetivo     Decimal
  cantidadProducida    Decimal                     @default(0)
  mermaTotal           Decimal                     @default(0)
  estado               EstadoProduccion            @default(BORRADOR)
  observaciones        String?
  usuarioResponsableId Int?
  creadoEn             DateTime                    @default(now())
  actualizadoEn        DateTime                    @updatedAt
  empresa              Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  receta               RecetaProduccion?           @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  productoFinal        Producto                    @relation("OrdenProductoFinal", fields: [productoFinalId], references: [id], onDelete: Cascade)
  usuarioResponsable   Usuario?                    @relation(fields: [usuarioResponsableId], references: [id], onDelete: SetNull)
  componentes          OrdenProduccionComponente[]
  movimientos          MovimientoProduccion[]

  @@unique([empresaId, loteProduccion])
  @@index([empresaId, estado])
  @@index([productoFinalId, fechaInicio])
  @@index([usuarioResponsableId])
}

model OrdenProduccionComponente {
  id                Int             @id @default(autoincrement())
  ordenProduccionId Int
  productoInsumoId  Int
  cantidadTeorica   Decimal
  cantidadConsumida Decimal         @default(0)
  mermaCantidad     Decimal         @default(0)
  unidad            String
  costoUnitario     Decimal?        @default(0)
  costoTotal        Decimal?        @default(0)
  observacion       String?
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt
  ordenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [id], onDelete: Cascade)
  productoInsumo    Producto        @relation("OrdenProductoInsumo", fields: [productoInsumoId], references: [id], onDelete: Cascade)

  @@unique([ordenProduccionId, productoInsumoId])
  @@index([ordenProduccionId])
  @@index([productoInsumoId])
}

model MovimientoProduccion {
  id                 Int                      @id @default(autoincrement())
  ordenProduccionId  Int
  empresaId          Int
  productoId         Int
  tipoMovimiento     TipoMovimientoProduccion
  cantidad           Decimal
  unidad             String
  costoUnitario      Decimal?                 @default(0)
  costoTotal         Decimal?                 @default(0)
  mermaCantidad      Decimal?                 @default(0)
  loteReferencia     String?
  fecha              DateTime                 @default(now())
  usuarioId          Int?
  observacion        String?
  movimientoKardexId Int?
  ordenProduccion    OrdenProduccion          @relation(fields: [ordenProduccionId], references: [id], onDelete: Cascade)
  empresa            Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto           Producto                 @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario            Usuario?                 @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  movimientoKardex   MovimientoKardex?        @relation(fields: [movimientoKardexId], references: [id], onDelete: SetNull)

  @@index([ordenProduccionId, fecha])
  @@index([empresaId, fecha])
  @@index([productoId])
  @@index([usuarioId])
  @@index([movimientoKardexId])
}

model TipoDocumento {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  descripcion String
  clientes    Cliente[]
}

model Cliente {
  id              Int            @id @default(autoincrement())
  nombre          String
  nroDoc          String
  direccion       String?
  email           String?
  telefono        String?
  empresaId       Int?
  estado          EstadoType     @default(ACTIVO)
  tipoDocumentoId Int?
  departamento    String?
  distrito        String?
  provincia       String?
  ubigeo          String?
  persona         PersonaType    @default(CLIENTE)
  // Campos médicos (farmacia/clínica) — opcionales, no afectan otros rubros
  grupoSanguineo  String?
  alergias        String?
  fechaNacimiento DateTime?
  medicoTratanteId Int?
  empresa         Empresa?       @relation(fields: [empresaId], references: [id])
  tipoDocumento   TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  medicoTratante  Doctor?        @relation("PacienteMedico", fields: [medicoTratanteId], references: [id])
  compras         Compra[]
  ordenesCompra   OrdenCompra[] @relation("OrdenCompraProveedor")
  comprobantes    Comprobante[]
  guiasRemision   GuiaRemision[]
  productoReviews ProductoReview[]
  detallesComosPaciente DetalleComprobante[] @relation("PacienteDetalle")
  vehiculos             Vehiculo[]

  // Lookup por documento en cada emisión de comprobante/compra (dedup de cliente/proveedor)
  @@index([empresaId, nroDoc])
}

model Doctor {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  nombre       String
  cmp          String?
  especialidad String?
  telefono     String?
  email        String?
  estado       EstadoType @default(ACTIVO)
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  pacientes    Cliente[] @relation("PacienteMedico")
  detalles     DetalleComprobante[] @relation("MedicoDetalle")

  @@index([empresaId])
}

model TipoOperacion {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique
  descripcion  String
  comprobantes Comprobante[]
}

model MotivoNota {
  id           Int           @id @default(autoincrement())
  tipo         TipoNota
  codigo       String
  descripcion  String
  comprobantes Comprobante[] @relation("ComprobanteMotivo")

  @@unique([tipo, codigo])
}

model TipoDetraccion {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique
  descripcion  String
  porcentaje   Decimal
  activo       Boolean       @default(true)
  comprobantes Comprobante[]
}

model MedioPagoDetraccion {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique
  descripcion  String
  activo       Boolean       @default(true)
  comprobantes Comprobante[]
}

model Comprobante {
  id                    Int                  @id @default(autoincrement())
  ublVersion            String               @default("2.1")
  tipoDoc               String
  serie                 String
  correlativo           Int
  fechaEmision          DateTime
  formaPagoTipo         String
  formaPagoMoneda       String
  tipoMoneda            String
  tipoCambio            Float?               @default(1) // TC del día cuando tipoMoneda = USD
  observaciones         String?
  // N° de Orden de Compra que el cliente (comprador B2B) pide referenciar en la Factura
  ordenCompraCliente    String?
  mtoOperGravadas       Float
  mtoIGV                Float
  valorVenta            Float
  totalImpuestos        Float
  subTotal              Float
  mtoImpVenta           Float
  estadoEnvioSunat      EstadoSunat          @default(PENDIENTE)
  medioPago             String?
  paymentDetails        Json?
  clienteId             Int
  empresaId             Int
  tipDocAfectado        String?
  numDocAfectado        String?
  creadoEn              DateTime             @default(now())
  tipoOperacionId       Int?
  motivoId              Int?
  mtoOperInafectas      Float                @default(0)
  mtoOperExoneradas     Float                @default(0)
  mtoOperExportacion    Float                @default(0)
  mtoDescuentoGlobal    Float                @default(0)
  mtoAnticipos          Float                @default(0)
  anticipos             Json?
  sunatCdrResponse      String?
  sunatCdrZip           String?
  sunatErrorMsg         String?
  sunatXml              String?
  documentoId           String?
  adelanto              Float?
  fechaRecojo           DateTime?
  saldo                 Float?               @default(0)
  estadoPago            EstadoPago?          @default(PENDIENTE_PAGO)
  descuentoOT           Float?               @default(0)
  descuentoPorcOT       Float?               @default(0)
  estadoOT              String?
  usuarioId             Int?
  // Cobranza en campo: vendedor de campo atribuido a la venta (se muestra como
  // "vendedor" en panel/notas/comprobante en vez del usuario que la registró).
  // Denormalizado (sin FK), igual que Pago.vendedorId/vendedorNombre.
  vendedorCampoId       Int?
  vendedorCampoNombre   String?
  s3CdrUrl              String?
  s3PdfUrl              String?
  s3XmlUrl              String?
  vuelto                Float?               @default(0)
  sunatLastRetryAt      DateTime?
  sunatNextRetryAt      DateTime?
  sunatRetriesCount     Int                  @default(0)
  cotizAdelanto         Float?               @default(0)
  cotizDescuento        Float?               @default(0)
  cotizFirmante         String?
  cotizIncluirImagenes  Boolean?             @default(false)
  cotizTerminos         String?
  cotizTipoPago         String?              @default("CONTADO")
  cotizVigencia         Int?                 @default(7)
  cotizMoneda           String?              @default("PEN")
  cuentaBancoNacion     String?
  medioPagoDetraccionId Int?
  montoDetraccion       Float?
  porcentajeDetraccion  Float?
  tipoDetraccionId      Int?
  cuotas                Json?
  fechaVencimientoCredito DateTime?
  cliente               Cliente              @relation(fields: [clienteId], references: [id])
  empresa               Empresa              @relation(fields: [empresaId], references: [id])
  medioPagoDetraccion   MedioPagoDetraccion? @relation(fields: [medioPagoDetraccionId], references: [id])
  motivo                MotivoNota?          @relation("ComprobanteMotivo", fields: [motivoId], references: [id])
  tipoDetraccion        TipoDetraccion?      @relation(fields: [tipoDetraccionId], references: [id])
  tipoOperacion         TipoOperacion?       @relation(fields: [tipoOperacionId], references: [id])
  usuario               Usuario?             @relation(fields: [usuarioId], references: [id])
  sedeId                Int?
  sede                  Sede?                @relation(fields: [sedeId], references: [id])
  // Auto-referencia: cuando un informal se convierte a Boleta/Factura
  comprobanteOrigenId   Int?
  comprobanteOrigen     Comprobante?         @relation("ConversionOrigen", fields: [comprobanteOrigenId], references: [id])
  comprobantesDerivados Comprobante[]        @relation("ConversionOrigen")
  detalles              DetalleComprobante[]
  leyendas              Leyenda[]
  movimientosKardex     MovimientoKardex[]
  pagos                 Pago[]
  whatsappEnvios        WhatsAppEnvio[]
  envioDespacho         EnvioDespacho?
  comisiones            ComisionVendedor[]
  campanas              CampanaMarketing[]
  productoSeries        ProductoSerie[]

  // Clave de negocio del comprobante: impide correlativos duplicados en la misma
  // serie a nivel de BD. Es la red que hace efectivo el reintento anti-colisión
  // de crearComprobanteConReintento (P2002) cuando varias sedes/cajas emiten a la
  // vez sobre la misma serie.
  @@unique([empresaId, tipoDoc, serie, correlativo])
  // Panel de ventas / reportes: filtran por empresa + rango de fecha, opcional sede/usuario
  @@index([empresaId, fechaEmision])
  @@index([empresaId, sedeId, fechaEmision])
  @@index([empresaId, usuarioId, fechaEmision])
  // resumenPorCobrarGlobal: comprobantes con saldo pendiente por empresa (sin filtro de fecha)
  @@index([empresaId, estadoPago])
}

model DetalleComprobante {
  id                Int           @id @default(autoincrement())
  comprobanteId     Int
  productoId        Int?
  unidad            String
  descripcion       String
  cantidad          Float
  mtoValorUnitario  Float
  mtoValorVenta     Float
  mtoBaseIgv        Float
  porcentajeIgv     Float
  igv               Float
  tipAfeIgv         Int
  totalImpuestos    Float
  numerosSerie      Json?
  mtoPrecioUnitario Float
  // Descuento por línea (monto bruto, incl. IGV) — solo para mostrar en el ticket el precio
  // de lista y el ahorro; el precio ya viene con descuento en mtoPrecioUnitario/mtoValorVenta,
  // por lo que NO afecta el XML enviado a SUNAT.
  mtoDescuento      Float?          @default(0)
  // Farmacia: trazabilidad de lote dispensado
  loteId            Int?
  // Farmacia: datos de receta médica y medicamentos controlados
  numeroReceta      String?
  dniPaciente       String?
  nombrePaciente    String?
  medicoNombre      String?
  // FKs opcionales — enlazan con entidades Doctor/Cliente si existen; los campos String se mantienen como fallback
  medicoId          Int?
  pacienteId        Int?
  comprobante       Comprobante   @relation(fields: [comprobanteId], references: [id])
  producto          Producto?     @relation(fields: [productoId], references: [id])
  lote              ProductoLote? @relation(fields: [loteId], references: [id])
  medico            Doctor?       @relation("MedicoDetalle", fields: [medicoId], references: [id])
  paciente          Cliente?      @relation("PacienteDetalle", fields: [pacienteId], references: [id])
  seriesVendidas    ProductoSerie[]

  // FK usada en todo include/join de ventas, dashboard, finanzas y kardex
  @@index([comprobanteId])
  @@index([productoId])
}

enum EstadoProductoSerie {
  DISPONIBLE
  VENDIDO
  RESERVADO
  BAJA
}

model ProductoSerie {
  id                   Int                 @id @default(autoincrement())
  empresaId            Int
  productoId           Int
  sedeId               Int?
  numeroSerie          String
  estado               EstadoProductoSerie @default(DISPONIBLE)
  garantiaMeses        Int?
  garantiaHasta        DateTime?
  comprobanteId        Int?
  detalleComprobanteId Int?
  compraId             Int?
  compraDetalleId      Int?
  observacion          String?
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt

  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto           Producto            @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sede               Sede?               @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  comprobante        Comprobante?        @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)
  detalleComprobante DetalleComprobante? @relation(fields: [detalleComprobanteId], references: [id], onDelete: SetNull)
  compra             Compra?             @relation(fields: [compraId], references: [id], onDelete: SetNull)
  compraDetalle      DetalleCompra?      @relation(fields: [compraDetalleId], references: [id], onDelete: SetNull)
  reclamos           ReclamoGarantia[]

  @@unique([empresaId, numeroSerie])
  @@index([empresaId, productoId, estado])
  @@index([comprobanteId])
  @@index([detalleComprobanteId])
  @@index([compraId])
}

enum EstadoReclamo {
  ABIERTO
  EN_PROCESO
  RESUELTO
  CERRADO
}

model ReclamoGarantia {
  id              Int           @id @default(autoincrement())
  empresaId       Int
  productoSerieId Int
  descripcion     String
  estadoReclamo   EstadoReclamo @default(ABIERTO)
  tecnico         String?
  resolucion      String?
  fechaReclamo    DateTime      @default(now())
  fechaResolucion DateTime?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoSerie ProductoSerie @relation(fields: [productoSerieId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([productoSerieId])
}

model Leyenda {
  id            Int         @id @default(autoincrement())
  comprobanteId Int
  code          String
  value         String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id])
}

model Pago {
  id                 Int              @id @default(autoincrement())
  comprobanteId      Int
  fecha              DateTime         @default(now())
  monto              Float
  medioPago          String
  observacion        String?
  referencia         String?
  // Imagen del comprobante de pago que el vendedor en campo envía a la encargada (opcional).
  comprobanteUrl     String?
  // A quién fue dirigido el pago: ADMINISTRADOR | EMPRESA | VENDEDOR (obligatorio en el registro manual).
  dirigidoA          String?
  // Si dirigidoA = VENDEDOR, a la cuenta de qué vendedor llegó el dinero (denormalizado, sin FK).
  vendedorId         Int?
  vendedorNombre     String?
  creadoEn           DateTime         @default(now())
  empresaId          Int?
  usuarioId          Int?
  cuentaBancariaId   Int?
  comprobante        Comprobante      @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  empresa            Empresa?         @relation(fields: [empresaId], references: [id])
  usuario            Usuario?         @relation(fields: [usuarioId], references: [id])
  cuentaBancaria     CuentaBancaria?  @relation(fields: [cuentaBancariaId], references: [id])

  @@index([comprobanteId])
  @@index([usuarioId])
  @@index([empresaId])
  @@index([cuentaBancariaId])
  @@index([vendedorId])
}

model CuentaBancaria {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  banco        String
  numeroCuenta String
  cci          String?
  titular      String?
  tipoCuenta   String   @default("AHORROS")
  moneda       String   @default("PEN")
  alias        String?
  activo       Boolean  @default(true)
  mostrarEnCotizacion Boolean @default(true)
  /// Medio de pago digital vinculado ('YAPE' | 'PLIN' | null). Los pagos con ese
  /// medio se consideran abonados automáticamente en esta cuenta (Yape/Plin
  /// depositan directo al banco), así que no pasan por el flujo manual de
  /// depósitos de caja (solo el efectivo). Máx. una cuenta activa por medio
  /// por empresa (validado en servicio).
  medioPagoVinculado String?
  creadoEn     DateTime @default(now())
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  pagos        Pago[]
  pagosCompra  PagoCompra[]
  gastosOperativos GastoOperativo[]
  movimientosCajaDepositados MovimientoCaja[]

  @@index([empresaId])
}

model MovimientoKardex {
  id                    Int                    @id @default(autoincrement())
  productoId            Int
  empresaId             Int
  tipoMovimiento        TipoMovimiento
  concepto              String
  comprobanteId         Int?
  cantidad              Decimal                @default(0) @db.Decimal(12, 3)
  stockAnterior         Decimal                @default(0) @db.Decimal(12, 3)
  stockActual           Decimal                @default(0) @db.Decimal(12, 3)
  costoUnitario         Decimal?
  valorTotal            Decimal?
  fecha                 DateTime               @default(now())
  usuarioId             Int?
  observacion           String?
  lote                  String?
  fechaVencimiento      DateTime?
  compraId              Int?
  compra                Compra?                @relation(fields: [compraId], references: [id])
  comprobante           Comprobante?           @relation(fields: [comprobanteId], references: [id])
  empresa               Empresa                @relation(fields: [empresaId], references: [id])
  producto              Producto               @relation(fields: [productoId], references: [id])
  usuario               Usuario?               @relation(fields: [usuarioId], references: [id])
  sedeId                Int?
  sede                  Sede?                  @relation(fields: [sedeId], references: [id])
  movimientoLotes       MovimientoKardexLote[]
  movimientosProduccion MovimientoProduccion[]

  @@index([productoId, fecha])
  @@index([empresaId, fecha])
  @@index([tipoMovimiento])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  // deleteMany por usuario al renovar sesión
  @@index([usuarioId])
}

model MovimientoCaja {
  id                 Int        @id @default(autoincrement())
  usuarioId          Int
  empresaId          Int
  tipoMovimiento     TipoCaja
  fecha              DateTime   @default(now())
  montoInicial       Decimal?
  montoFinal         Decimal?
  montoEfectivo      Decimal?   @default(0)
  montoYape          Decimal?   @default(0)
  montoPlin          Decimal?   @default(0)
  montoTransferencia Decimal?   @default(0)
  montoTarjeta       Decimal?   @default(0)
  observaciones      String?
  estado             EstadoType @default(ACTIVO)
  fechaCierre        DateTime?
  totalVentas        Decimal?   @default(0)
  totalIngresos      Decimal?   @default(0)
  diferencia         Decimal?   @default(0)
  turno              String?
  monto              Decimal?
  categoriaGasto     String?
  descripcionGasto   String?
  metodoPago         String?
  empresa            Empresa    @relation(fields: [empresaId], references: [id])
  usuario            Usuario    @relation(fields: [usuarioId], references: [id])

  sedeId Int?
  sede   Sede? @relation(fields: [sedeId], references: [id])

  // Transferencia de efectivo entre cajas de distintas sedes: en la fila
  // EGRESO (origen), sedeContraparteId apunta a la sede destino; en la fila
  // INGRESO (destino), apunta a la sede origen. movimientoVinculadoId
  // conecta cada fila con su contraparte en la otra caja.
  esTransferencia   Boolean @default(false)
  sedeContraparteId Int?
  sedeContraparte   Sede?   @relation("MovimientoCajaContraparte", fields: [sedeContraparteId], references: [id])

  movimientoVinculadoId Int?
  movimientoVinculado   MovimientoCaja?  @relation("VinculoTransferenciaCaja", fields: [movimientoVinculadoId], references: [id])
  movimientosVinculados MovimientoCaja[] @relation("VinculoTransferenciaCaja")

  // Aprobación de gastos (maker-checker, solo filas EGRESO): 'PENDIENTE' |
  // 'APROBADO' | 'RECHAZADO'. null = sin flujo de aprobación (legacy o
  // empresa con requiereAprobacionGastos apagado) y cuenta como aprobado.
  // PENDIENTE/RECHAZADO se excluyen de los totales del cierre.
  estadoAprobacion     String?
  // Quién aprobó/rechazó (denormalizado, sin FK — igual que vendedorCampoId).
  aprobadoPorUsuarioId Int?

  // Depósito bancario del efectivo declarado en un cierre (tipoMovimiento
  // CIERRE): trazabilidad de qué depósito corresponde a qué cierre de caja.
  depositado              Boolean         @default(false)
  cuentaBancariaId        Int?
  cuentaBancaria          CuentaBancaria? @relation(fields: [cuentaBancariaId], references: [id])
  fechaDeposito           DateTime?
  numeroOperacionDeposito String?
  depositadoPorUsuarioId  Int?
  depositadoPor           Usuario?        @relation("DepositoCajaRealizadoPor", fields: [depositadoPorUsuarioId], references: [id])

  @@index([usuarioId, fecha])
  @@index([empresaId, fecha])
  @@index([tipoMovimiento])
}

model PedidoTienda {
  id                Int                     @id @default(autoincrement())
  empresaId         Int
  clienteNombre     String
  clienteTelefono   String
  clienteEmail      String?
  clienteDireccion  String?
  clienteReferencia String?
  subtotal          Decimal
  igv               Decimal                 @default(0)
  total             Decimal
  estado            EstadoPedidoTienda      @default(PENDIENTE)
  estadoEntrega     String                  @default("PENDIENTE")
  agenciaEnvio      String?
  estadoEnvio       String                  @default("SIN_ASIGNAR")
  medioPago         MedioPagoTienda         @default(YAPE)
  montoPagado       Decimal                 @default(0)
  saldoPendiente    Decimal                 @default(0)
  observaciones     String?
  referenciaTransf  String?
  creadoEn          DateTime                @default(now())
  actualizadoEn     DateTime                @updatedAt
  fechaConfirmacion DateTime?
  usuarioConfirma   Int?
  comprobanteId     Int?
  codigoSeguimiento String                  @unique
  costoEnvio        Decimal                 @default(0)
  notasInternas     String?
  vendedorId        Int?
  vendedorNombre    String?
  numeroTracking    String?
  tipoEntrega       TipoEntrega             @default(RECOJO)
  historialEstados  HistorialEstadoPedido[]
  items             ItemPedidoTienda[]
  reviews           ProductoReview[]
  empresa           Empresa                 @relation(fields: [empresaId], references: [id])
  repartidorId      Int?
  repartidor        Repartidor?             @relation(fields: [repartidorId], references: [id], onDelete: SetNull)

  sedeId Int?
  sede   Sede? @relation(fields: [sedeId], references: [id])

  @@index([empresaId, estado])
  @@index([empresaId, estadoEntrega])
  @@index([empresaId, estadoEnvio])
  @@index([creadoEn])
  @@index([codigoSeguimiento])
  @@index([repartidorId])
}

model ItemPedidoTienda {
  id            Int          @id @default(autoincrement())
  pedidoId      Int
  productoId    Int
  cantidad      Int
  precioUnit    Decimal
  subtotal      Decimal
  observacion   String?
  comboId       Int?
  comboSnapshot String?
  esCombo       Boolean      @default(false)
  combo         Combo?       @relation(fields: [comboId], references: [id])
  pedido        PedidoTienda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto      Producto     @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
  @@index([comboId])
}

model Combo {
  id                  Int                @id @default(autoincrement())
  empresaId           Int
  nombre              String
  descripcion         String?
  imagenUrl           String?
  precioRegular       Decimal
  precioCombo         Decimal
  descuentoPorcentaje Decimal?
  activo              Boolean            @default(true)
  stock               Int?
  fechaInicio         DateTime?
  fechaFin            DateTime?
  creadoEn            DateTime           @default(now())
  actualizadoEn       DateTime           @updatedAt
  pedidoItems         ItemPedidoTienda[]
  items               ComboItem[]
  empresa             Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, activo])
  @@map("combos")
}

model ComboItem {
  id         Int      @id @default(autoincrement())
  comboId    Int
  productoId Int
  cantidad   Int      @default(1)
