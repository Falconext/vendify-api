// ─── Órdenes de Compra: pedido al proveedor previo a la Compra ───────────────
model OrdenCompra {
  id              Int                  @id @default(autoincrement())
  empresaId       Int
  sedeId          Int?
  proveedorId     Int
  usuarioId       Int?
  numero          Int
  fechaEmision    DateTime             @default(now())
  fechaEntrega    DateTime?
  moneda          String               @default("PEN")
  tipoCambio      Decimal?             @default(1)
  subtotal        Decimal              @default(0)
  igv             Decimal              @default(0)
  total           Decimal              @default(0)
  // true = los precios unitarios de los detalles ya traen el IGV embebido
  igvIncluido     Boolean              @default(false)
  estado          EstadoOrdenCompra    @default(EMITIDA)
  observaciones   String?
  condicionesPago String?
  lugarEntrega    String?
  compraId        Int?                 @unique
  creadoEn        DateTime             @default(now())
  actualizadoEn   DateTime             @updatedAt
  empresa         Empresa              @relation(fields: [empresaId], references: [id])
  sede            Sede?                @relation(fields: [sedeId], references: [id])
  proveedor       Cliente              @relation("OrdenCompraProveedor", fields: [proveedorId], references: [id])
  usuario         Usuario?             @relation(fields: [usuarioId], references: [id])
  compra          Compra?              @relation(fields: [compraId], references: [id])
  detalles        DetalleOrdenCompra[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

