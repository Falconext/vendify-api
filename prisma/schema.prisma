// Códigos de barra ADICIONALES por producto. Un mismo producto (p. ej. un perfume
// sellado importado en distintos lotes) puede traer un EAN/UPC diferente por
// importación, pero es el MISMO producto (mismo precio, mismo stock). Al escanear
// cualquiera de estos códigos se resuelve al producto padre. El `codigoBarras`
// principal vive en Producto; esta tabla guarda los alternos.
model ProductoCodigoBarras {
  id         Int      @id @default(autoincrement())
  productoId Int
  empresaId  Int
  codigo     String
  /// Unidades del producto base que representa este código al escanearlo (ej. el
  /// código del six-pack de cervezas vale 6; el código individual de la cerveza
  /// suelta usa el default 1). Todos los códigos comparten el MISMO stock.
  unidadesPorPaquete Int      @default(1)
  /// Precio TOTAL del paquete cuando se vende por este código (suele ser más
  /// barato que unidades × precio unitario). null = sin precio propio: se
  /// cobra precioUnitario × unidadesPorPaquete.
  precioPaquete Decimal?
  /// Nombre propio del paquete (ej. "SIX PACK CERVEZA PILSEN"): se muestra en
  /// el formulario y como descripción de la línea al vender por este código.
  alias      String?
  /// Imagen propia del paquete (S3), opcional — solo presentación/orden.
  imagenUrl  String?
  creadoEn   DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@index([productoId])
  @@map("producto_codigos_barras")
}

/// Tabla Maestra de Productos: catálogo GLOBAL (sin empresaId) indexado por
/// código de barras. Devuelve imagen/categoría/marca sugeridas. Se consulta
/// antes de la IA/Serper y se autopobla con lo que la IA resuelve (cache-through).
model ProductoMaestro {
  id            Int      @id @default(autoincrement())
  codigoBarras  String?  @unique
  nombre        String
  nombreNorm    String
  marca         String?
  categoria     String?
  imagenUrl     String?
  descripcion   String?
  fuente        String   @default("IA") // IA | SERPER | MANUAL | IMPORT
  aprobada      Boolean  @default(false)
  vecesUsada    Int      @default(1)
  ultimoUsoEn   DateTime @default(now())
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombreNorm, marca])
  @@index([aprobada])
  @@map("producto_maestro")
}

