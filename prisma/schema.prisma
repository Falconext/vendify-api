enum EstadoDespacho {
  PREPARANDO
  EN_CAMINO
  EN_AGENCIA
  EN_DESTINO
  ENTREGADO
  DEVUELTO
}

enum TipoRepartidor {
  PLANILLA
  EVENTUAL
}

model EnvioDespacho {
  id               Int            @id @default(autoincrement())
  comprobanteId    Int            @unique
  comprobante      Comprobante    @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  transportista    String?
  codigoGuia       String?
  estado           EstadoDespacho @default(PREPARANDO)
  observaciones    String?
  direccionDestino String?
  fechaEstimada    DateTime?
  historial        Json?
  // Coordinación de envío nacional
  tipoEnvio        String? // AGENCIA | DOMICILIO
  agenciaDestino   String? // Nombre de agencia destino (ej: "Shalom Cusco Centro")
  celularDest      String? // Celular del destinatario
  nroPaquetes      Int?           @default(1)
  turnoEnvio       String? // MANANA | TARDE | NOCHE
  tipoMercaderia   String? // Clasificación para el courier (Shalom)
  claveEnvio       String?
  nroOrden         String?
  claveOrden       String?
  establecimiento  String? // Local/sucursal desde donde despacha
  repartidorId     Int?
  repartidor       Repartidor?    @relation(fields: [repartidorId], references: [id], onDelete: SetNull)
  empaquetador       String? // Nombre del empaquetador
  // Datos del destinatario (Shalom)
  nombreDestinatario String? // Nombre completo del destinatario
  dniDestinatario    String? // DNI/documento del destinatario
  contenidoPaquete   String? // Descripción del contenido (ej: "1 Caja")
  montoCOD           Float?  // Monto a cobrar en destino (Shalom COD)
  costoEnvio         Float?  @default(0) // Monto cobrado al cliente o absorbido por el negocio
  pagarFlete         String? @default("NEGOCIO") // CLIENTE | NEGOCIO
  aplicacionMontoCliente String? @default("NEGOCIO") // ITEM_ENVIO | ADELANTO | NEGOCIO
  creadoEn           DateTime       @default(now())
  actualizadoEn      DateTime       @updatedAt

  @@index([comprobanteId])
  @@index([repartidorId])
}

model Repartidor {
  id             Int             @id @default(autoincrement())
  nombre         String
  celular        String?
  tipo           TipoRepartidor  @default(EVENTUAL)
  activo         Boolean         @default(true)
  empresaId      Int
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sedeId         Int?
  sede           Sede?           @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  creadoEn       DateTime        @default(now())
  actualizadoEn  DateTime        @updatedAt
  enviosDespacho EnvioDespacho[]
  pedidosTienda  PedidoTienda[]

  @@unique([empresaId, nombre])
  @@index([empresaId, activo])
  @@index([sedeId])
}

model DespachoMensajeTemplate {
  id        Int     @id @default(autoincrement())
  empresaId Int     @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  mensajeEnCamino    String?
  mensajeEntregado   String?
  notificarEnCamino  Boolean @default(true)
  notificarEntregado Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model GuiaRemision {
  id        Int @id @default(autoincrement())
  empresaId Int

  // Información del documento
  tipoGuia      TipoGuiaRemision @default(REMITENTE) // Tipo de guía
  serie         String
  correlativo   Int
  fechaEmision  DateTime
  horaEmision   String?
  tipoDocumento String           @default("09") // Código SUNAT: 09=Remitente, 31=Transportista

  // Remitente (DespatchSupplierParty)
  remitenteRuc         String
  remitenteRazonSocial String
  remitenteDireccion   String

  // Destinatario (DeliveryCustomerParty)
  destinatarioTipoDoc     String
  destinatarioNumDoc      String
  destinatarioRazonSocial String

  // Shipment
  tipoTraslado   String // 01: Venta, 02: Compra, etc.
  modoTransporte String // 01: Transporte Público, 02: Transporte Privado
  pesoTotal      Decimal
  unidadPeso     String  @default("KGM")

  // Transportista (para transporte público)
  transportistaRuc         String?
  transportistaRazonSocial String?
  transportistaMTC         String? // Registro MTC

  // Para GRE-T: remitente real de los bienes (diferente al transportista)
  // En GRE-T, DespatchParty = quien envía la carga (puede ser otra empresa)
  greTRemitenteNumDoc      String? // RUC/DNI del remitente de los bienes
  greTRemitenteRazonSocial String? // Razón social del remitente de los bienes

  // Conductor/Vehículo (para transporte privado)
  conductorTipoDoc     String?
  conductorNumDoc      String?
  conductorNombre      String?
  conductorApellidos   String?
  conductorLicencia    String?
  vehiculoPlaca        String?
  vehiculoAutorizacion String?

  // Punto de partida
  partidaUbigeo                String
  partidaDireccion             String
  partidaCodigoEstablecimiento String?

  // Punto de llegada
  llegadaUbigeo                String
  llegadaDireccion             String
  llegadaCodigoEstablecimiento String?

  // Fecha de traslado
  fechaInicioTraslado DateTime

  // Flags opcionales
  retornoVehiculoVacio Boolean @default(false)
  retornoEnvasesVacios Boolean @default(false)
  transbordoProgramado Boolean @default(false)
  trasladoTotal        Boolean @default(false) // DAM o DS
  vehiculoM1oL         Boolean @default(false)
  datosTransportista   Boolean @default(false)

  // SUNAT
  estadoSunat       EstadoSunat @default(PENDIENTE)
  sunatXml          String?
  sunatCdrResponse  String?
  sunatCdrZip       String?
  sunatErrorMsg     String?
  documentoId       String? // ID del proveedor SUNAT
  s3XmlUrl          String?
  s3CdrUrl          String?
  s3PdfUrl          String?
  sunatRetriesCount Int         @default(0)
  sunatNextRetryAt  DateTime?
  sunatLastRetryAt  DateTime?

  // Observaciones
  observaciones String?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuarioId     Int?
  clienteId     Int? // Destinatario si está registrado

  // Relaciones
  empresa        Empresa               @relation(fields: [empresaId], references: [id])
  usuario        Usuario?              @relation(fields: [usuarioId], references: [id])
  cliente        Cliente?              @relation(fields: [clienteId], references: [id])
  detalles       DetalleGuiaRemision[]
  whatsappEnvios WhatsAppEnvio[]

  sedeId Int?
  sede   Sede? @relation(fields: [sedeId], references: [id])

  @@unique([empresaId, serie, correlativo])
  @@index([empresaId, fechaEmision])
  @@index([estadoSunat])
}

model DetalleGuiaRemision {
  id             Int @id @default(autoincrement())
  guiaRemisionId Int
  numeroOrden    Int // Orden del ítem

  productoId     Int?
  codigoProducto String
  descripcion    String

  cantidad     Decimal
  unidadMedida String  @default("NIU")

  // Relaciones
  guiaRemision GuiaRemision @relation(fields: [guiaRemisionId], references: [id], onDelete: Cascade)
  producto     Producto?    @relation(fields: [productoId], references: [id])

  @@index([guiaRemisionId])
}

model Modulo {
  id              Int          @id @default(autoincrement())
  codigo          String // 'dashboard', 'comprobantes', etc.
  producto        String       @default("facturacion")
  nombre          String // 'Dashboard', 'Comprobantes', etc.
  descripcion     String?
  icono           String? // Nombre del icono de Iconify
  ruta            String? // Ruta de navegación, e.g. '/administrador/ventas'
  activo          Boolean      @default(true)
  orden           Int          @default(0)
  planesAsignados PlanModulo[]
  subModulos      SubModulo[]
  creadoEn        DateTime     @default(now())

  @@unique([codigo, producto])
  @@index([producto])
  @@index([activo, orden])
}

model SubModulo {
  id              Int                @id @default(autoincrement())
  moduloId        Int
  modulo          Modulo             @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  codigo          String             @unique
  nombre          String
  descripcion     String?
  ruta            String? // Ruta de navegación, e.g. '/administrador/ventas/panel'
  activo          Boolean            @default(true)
  orden           Int                @default(0)
  creadoEn        DateTime           @default(now())
  usuarios        UsuarioSubModulo[]
  planesAsignados PlanSubModulo[]

  @@index([moduloId])
  @@index([activo, orden])
}

model PlanSubModulo {
  id          Int       @id @default(autoincrement())
  planId      Int
  subModuloId Int
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  subModulo   SubModulo @relation(fields: [subModuloId], references: [id], onDelete: Cascade)

  @@unique([planId, subModuloId])
  @@index([planId])
  @@index([subModuloId])
}

model PlanModulo {
  id       Int    @id @default(autoincrement())
  planId   Int
  moduloId Int
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([planId, moduloId])
  @@index([planId])
  @@index([moduloId])
}

model Reseller {
  id                        Int      @id @default(autoincrement())
  nombre                    String
  codigo                    String   @unique // Unique code for the reseller
  dominioPersonalizado      String?  @unique
  whiteLabelNombre          String?
  whiteLabelLogoUrl         String?
  whiteLabelLogoWhiteUrl    String?
  whiteLabelFaviconUrl      String?
  whiteLabelColorPrimario   String?
  whiteLabelColorSecundario String?
  whiteLabelWebsite         String?
  whiteLabelEmail           String?
  whiteLabelTelefono        String?
  whiteLabelWhatsapp        String?
  representante             String?
  telefono                  String?
  email                     String   @unique // Contact email
  saldo                     Decimal  @default(0) @db.Decimal(10, 2)
  porcentajeDescuento       Decimal  @default(20.00) @db.Decimal(5, 2) // Porcentaje de descuento (20, 30, 40)
  preciosPlan               Json?    // Precio de venta que el reseller cobra por plan: { "Emprendedor": 25, "Negocio": 60, "Corporativo": 120 }
  activo                    Boolean  @default(true)
  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt

  empresas    Empresa[]
  usuarios    Usuario[]
  recargas    ResellerRecarga[]
  movimientos ResellerMovimiento[]
}

model ResellerRecarga {
  id          Int      @id @default(autoincrement())
  resellerId  Int
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime @default(now())
  medioPago   String?
  referencia  String? // Transaction ID
  observacion String?
  usuarioId   Int? // User who processed the recharge (Admin)

  reseller Reseller @relation(fields: [resellerId], references: [id])
}

// Catálogo de productos que Falconext vende en su propio portal web
model StoreProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  badge       String? // "Nuevo", "Popular", "Oferta", etc.
  category    String? // "Accesorios" | "Combo" | "Equipos" | "Sistema"
  stock       Int? // null = stock desconocido / ilimitado, 0 = agotado
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@index([category])
  @@map("store_products")
}

model ResellerMovimiento {
  id          Int      @id @default(autoincrement())
  resellerId  Int
  empresaId   Int? // Link to the client company causing the charge
  tipo        String // "MENSUALIDAD", "ACTIVACION", "DEVOLUCION"
  monto       Decimal  @db.Decimal(10, 2) // Amount deducted (usually negative)
  estado      String   @default("APLICADO") // "APLICADO", "PENDIENTE", "RECHAZADO"
  intento     Int      @default(1)
  motivo      String?
  fecha       DateTime @default(now())
  descripcion String?
  // Idempotencia de renovaciones: día (Lima, YYYY-MM-DD) del vencimiento que se
  // renovó. Solo se setea en MENSUALIDAD APLICADO; el unique hace físicamente
  // imposible cobrar dos veces el mismo ciclo (los NULL no colisionan).
  periodo     String?

  reseller Reseller @relation(fields: [resellerId], references: [id])
  empresa  Empresa? @relation(fields: [empresaId], references: [id])

  // NOTA: la constraint @@unique([empresaId, tipo, periodo]) para idempotencia de
  // renovaciones se retiró temporalmente porque el deploy (prisma db push) fallaba
  // por posibles duplicados existentes en prod. Reaplicar tras depurar duplicados.
  @@index([resellerId, tipo, estado])
  @@index([empresaId, tipo, fecha])
}

model GastoSistema {
  id            Int      @id @default(autoincrement())
  concepto      String
  categoria     String // HOSTING, HERRAMIENTAS, NOMINA, MARKETING, LEGAL, OTROS
  monto         Decimal
  fecha         DateTime
  descripcion   String?
  recurrente    Boolean  @default(false)
  periodicidad  String? // MENSUAL, ANUAL
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([fecha])
  @@index([categoria])
}

model NotaEmpresa {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contenido   String
  autorNombre String
  autorEmail  String
  notificado  Boolean  @default(false)
  creadoEn    DateTime @default(now())

  @@index([empresaId])
}

model EmpresaLog {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion      String // CREADA, ACTIVADA, DESACTIVADA, EDITADA, PLAN_CAMBIADO
  detalle     String?
  autorNombre String
  autorEmail  String
  creadoEn    DateTime @default(now())

  @@index([empresaId])
  @@index([creadoEn])
}

model IngresoManual {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  concepto      String
  tipo          String   // VENTA, PRESTAMO, INVERSION, CAPITAL, OTROS
  monto         Decimal  @db.Decimal(12, 2)
  fecha         DateTime
  descripcion   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, fecha])
  @@index([empresaId, tipo])
}

model IngresoSistema {
  id            Int      @id @default(autoincrement())
  concepto      String
  tipo          String // SUSCRIPCION, ACTIVACION, SOPORTE, PERSONALIZADO, OTROS
  monto         Decimal
  fecha         DateTime
  descripcion   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([fecha])
  @@index([tipo])
}

model DigemidProducto {
  id                Int      @id @default(autoincrement())
  nombreComercial   String
  principioActivo   String?
  formaFarmaceutica String?
  concentracion     String?
  presentacion      String?
  laboratorio       String?
  registroSanitario String?
  condicionVenta    String?
  estado            String?
  codigoBarras      String?
  creadoEn          DateTime @default(now())

  @@index([nombreComercial])
  @@index([principioActivo])
  @@index([codigoBarras])
  @@index([estado])
  @@map("digemid_productos")
}

enum CategoriaGasto {
  PUBLICIDAD
  SUELDOS
  ENVIOS
  COMISIONES
  ALQUILER
  OTROS
  PERSONALIZADA
}

model GastoOperativo {
  id            Int            @id @default(autoincrement())
  empresaId     Int
  mes           Int
  anio          Int
  fecha         DateTime?
  recurrenteDiario Boolean      @default(false)
  fechaInicio   DateTime?
  fechaFin      DateTime?
  categoria     CategoriaGasto
  etiqueta      String?
  monto         Decimal        @db.Decimal(12, 2)
  moneda        String         @default("PEN")
  tipoCambio    Decimal?       @db.Decimal(10, 4)
  cuentaBancariaId Int?
  medioPago     String?
  proveedor     String?
  numeroDocumento String?
  numeroOperacion String?
  descripcion   String?
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cuentaBancaria CuentaBancaria? @relation(fields: [cuentaBancariaId], references: [id], onDelete: SetNull)

  @@index([empresaId, anio, mes])
  @@index([empresaId, fecha])
  @@index([empresaId, recurrenteDiario, fechaInicio, fechaFin])
  @@index([empresaId, categoria])
}

/// Historial de conciliaciones bancarias guardadas por el usuario.
/// `resultado` almacena el objeto completo { resumen, movimientos, sistemaPendientes }
/// para poder re-visualizar la conciliación tal cual se calculó.
model ConciliacionBancariaGuardada {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  usuarioId     Int?
  fechaInicio   String?
  fechaFin      String?
  observaciones String?
  resumen       Json
  resultado     Json
  creadoEn      DateTime @default(now())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, creadoEn])
}

enum EstadoComision {
  PENDIENTE
  PAGADO
}

enum PlataformaAds {
  META
  TIKTOK
}

enum EstadoCampana {
  ACTIVA
  PAUSADA
}

enum FrecuenciaPresupuesto {
  DIARIO
  SEMANAL
  MENSUAL
  TOTAL
}

model CampanaMarketing {
  id                Int            @id @default(autoincrement())
  empresaId         Int
  nombre            String
  plataforma        PlataformaAds
  productoId        Int?
  vendedorId        Int?
  comprobanteId     Int?
  presupuestoDiario Decimal        @db.Decimal(10, 2) // Guardará el prorrateo diario internamente
  presupuestoOriginal Decimal?     @db.Decimal(10, 2) // Guardará el monto original introducido (ej. 140 semanal)
  tipoPresupuesto   FrecuenciaPresupuesto @default(DIARIO)
  moneda            String         @default("PEN")
  fechaInicio       DateTime
  fechaFin          DateTime?
  esRecurrente      Boolean        @default(false)
  estado            EstadoCampana  @default(ACTIVA)
  creadoEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt

  empresa           Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto          Producto?      @relation(fields: [productoId], references: [id], onDelete: SetNull)
  vendedor          Usuario?       @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  comprobante       Comprobante?   @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)

  @@index([empresaId, estado])
  @@index([empresaId, productoId])
  @@index([vendedorId])
  @@index([comprobanteId])
}

model ComisionVendedor {
  id              Int             @id @default(autoincrement())
  vendedorId      Int
  comprobanteId   Int
  productoId      Int?
  empresaId       Int
  mes             Int
  anio            Int
  cantidad        Decimal         @db.Decimal(12, 4)
  montoComision   Decimal         @db.Decimal(12, 2)
  descripcion     String?
  motivo          String?
  estado          EstadoComision  @default(PENDIENTE)
  creadoEn        DateTime        @default(now())
  actualizadoEn   DateTime        @updatedAt
  vendedor        Usuario         @relation(fields: [vendedorId], references: [id])
  comprobante     Comprobante     @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([vendedorId, mes, anio])
  @@index([empresaId, mes, anio])
  @@index([comprobanteId])
  @@index([vendedorId, estado])
}

// =============================================
// MÓDULO VEHICULAR (Seguridad Electrónica GPS/Alarmas)
// =============================================

model Vehiculo {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  sedeId        Int?
  placa         String
  marca         String
  modelo        String?
  color         String?
  anio          Int?
  kilometraje      Int?
  nivelCombustible String? // LLENO | 3/4 | 1/2 | 1/4 | VACIO
  clienteId     Int?
  observaciones String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa   Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente   Cliente?           @relation(fields: [clienteId], references: [id])
  actas     ActaInspeccion[]
  contratos ContratoVehicular[]
  contratoItems ContratoVehiculoItem[]

  @@unique([empresaId, placa])
  @@index([empresaId])
  @@index([empresaId, placa])
  @@index([clienteId])
}

model ActaInspeccion {
  id                Int      @id @default(autoincrement())
  vehiculoId        Int
  tipo              String   // INGRESO | RETIRO
  km                Int?
  nivelCombustible  String?  // LLENO | 3/4 | 1/2 | 1/4 | VACIO
  observaciones     String?
  fotos             String[] // URLs en S3
  checklist         Json?    // [{ categoria, item, estado, nota }] estado del vehículo al ingreso/retiro
  usuarioId         Int?
  creadoEn          DateTime @default(now())

  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([vehiculoId])
  @@index([vehiculoId, tipo])
}

model ContratoVehicular {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  vehiculoId    Int
  productoId    Int?
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        String   @default("VIGENTE") // VIGENTE | POR_VENCER | VENCIDO | CANCELADO
  montoAnual    Decimal? @db.Decimal(12, 2)
  observaciones String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculo  Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  producto  Producto? @relation(fields: [productoId], references: [id])
  unidades  ContratoVehiculoItem[]

  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([vehiculoId])
  @@index([fechaFin])
}

// Vehículos incluidos en un contrato (permite contratos multi-vehículo con
// monto individual por unidad). El `vehiculoId` de ContratoVehicular apunta al
// vehículo principal (el primero) y se conserva por compatibilidad; el detalle
// completo de unidades vive aquí.
model ContratoVehiculoItem {
  id         Int      @id @default(autoincrement())
  contratoId Int
  vehiculoId Int
  montoAnual Decimal? @db.Decimal(12, 2)
  creadoEn   DateTime @default(now())

  contrato ContratoVehicular @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo          @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, vehiculoId])
  @@index([contratoId])
  @@index([vehiculoId])
}

// ─── Listas de Precio (multi-local/minimarket) ──────────────────────────────
// Una lista con nombre se asigna a una o varias sedes y/o usuarios, y fija el
// precio por producto (y por presentación de paquete). Al vender, el precio se
// resuelve por precedencia: lista del usuario > lista default de la sede >
// override legado de ProductoStock > precio base del producto.
model ListaPrecio {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  nombre        String
  activo        Boolean  @default(true)
  esPorDefecto  Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa  Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sedes    ListaPrecioSede[]
  usuarios ListaPrecioUsuario[]
  items    ListaPrecioItem[]

  @@index([empresaId])
}

model ListaPrecioSede {
  id            Int @id @default(autoincrement())
  listaPrecioId Int
  sedeId        Int

  listaPrecio ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  sede        Sede        @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, sedeId])
  @@index([listaPrecioId])
  @@index([sedeId])
}

model ListaPrecioUsuario {
  id            Int @id @default(autoincrement())
  listaPrecioId Int
  usuarioId     Int

  listaPrecio ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, usuarioId])
  @@index([listaPrecioId])
  @@index([usuarioId])
}

model ListaPrecioItem {
  id            Int      @id @default(autoincrement())
  listaPrecioId Int
  productoId    Int
  // "" = precio de la unidad base; si no, matchea ProductoCodigoBarras.codigo
  // (presentación de paquete) del mismo producto. Se usa "" en vez de null para
  // que el unique compuesto trate "unidad base" como un valor único por producto.
  presentacionCodigo String  @default("")
  precioUnitario     Decimal @db.Decimal(12, 4)
  precioOferta       Decimal? @db.Decimal(12, 4)

  listaPrecio ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, productoId, presentacionCodigo])
  @@index([listaPrecioId])
  @@index([productoId])
}
